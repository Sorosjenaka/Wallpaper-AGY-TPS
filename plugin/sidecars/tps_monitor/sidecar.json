{
  "command": "node",
  "args": [
    "main.mjs"
  ],
  "restart_policy": "always",
  "display_name": "TPS Monitor",
  "description": "Live Tokens Per Second (tok/s), turn latency, context size, and prompt cache hit rate for Antigravity Desktop conversations.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "TPS Monitor",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "TPS Monitor"
      }
    ]
  }
}
